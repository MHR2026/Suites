# Configuración para el servidor Apache (IONOS / 1&1)

ErrorDocument 404 /404.html
Options -Indexes -MultiViews

# Configuración del formulario: nunca accesible desde la web
<Files "mhr-form-config.php">
  Require all denied
</Files>
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio definitivo: forzar https://suites.sonsampoli.com (sin www)
  RewriteCond %{HTTP_HOST} ^(www\.)?suites\.sonsampoli\.com$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://suites.sonsampoli.com%{REQUEST_URI} [L,R=301]

  # Portada: idioma según el navegador (el primero de la lista por defecto)
  RewriteCond %{HTTP:Accept-Language} ^(es|en|de|fr|it) [NC]
  RewriteRule ^$ /%1/ [L,R=302]
  RewriteRule ^$ /es/ [L,R=302]

  # URLs de la web anterior (OctoSite)
  RewriteRule ^(es|de|fr|it)/property-categories/?$ /$1/#alojamiento [L,R=301,NE]
  RewriteRule ^property-categories/?$ /en/#alojamiento [L,R=301,NE]
  RewriteRule ^(es|de|fr|it)/contact/?$ /$1/contacto/ [L,R=301]
  RewriteRule ^contact/?$ /en/contacto/ [L,R=301]
  RewriteRule ^(es|de|fr|it)/privacy-policy[^/]*/?$ /$1/legal/ [L,R=301]
  RewriteRule ^(es|de|fr|it)/real-estate/.*$ /$1/#alojamiento [L,R=301,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HTTPS obligatorio en el navegador para el dominio definitivo (no afecta a subdominios)
  <If "%{HTTPS} == 'on' && %{HTTP_HOST} == 'suites.sonsampoli.com'">
    Header always set Strict-Transport-Security "max-age=31536000"
  </If>

  # La web de pruebas (subdominios de pruebas) no debe aparecer en Google
  <If "%{HTTP_HOST} != 'suites.sonsampoli.com' && %{HTTP_HOST} != 'www.suites.sonsampoli.com'">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml text/plain image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
